# Example environment variables for OPTIONAL online collection and LLM coding.
# Do not put real credentials in a committed file or a submission ZIP.
# Assign these variables in your shell/session; scripts read os.getenv.
# Part 1 Gemini model calls (leave unset for offline verification):
GEMINI_API_KEY=YOUR_KEY_HERE
# Part 2 SEC collection: real contact name and email required by the SEC user-agent policy.
SEC_USER_AGENT=YourName YourRealEmail@example.org
